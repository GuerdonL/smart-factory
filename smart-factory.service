# Runs the editor's server and keeps it running. Install with:
#   sed "s#/srv/smart-factory#$PWD#g; s#^User=smart-factory#User=$USER#; s#^Group=smart-factory#Group=$(id -gn)#" smart-factory.service | sudo tee /etc/systemd/system/smart-factory.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now smart-factory
# Change User, Group and the paths below if the repository is not at /srv/smart-factory.
[Unit]
Description=Smart Factory editor
After=network-online.target
Wants=network-online.target

[Service]
User=smart-factory
Group=smart-factory
WorkingDirectory=/srv/smart-factory
ExecStart=/usr/bin/python3 -B /srv/smart-factory/server.py 8000
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/srv/smart-factory
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
